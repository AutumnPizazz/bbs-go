# Use the exact repository and version printed on the GitHub Release page.
BBSGO_IMAGE=replace-with-image:v1.0.0
BBSGO_HTTP_PORT=3000

BBSGO_MYSQL_DATABASE=bbsgo
BBSGO_MYSQL_USER=bbsgo
# Replace both values with different long random strings before starting.
BBSGO_MYSQL_PASSWORD=replace-with-a-random-password
BBSGO_MYSQL_ROOT_PASSWORD=replace-with-another-random-password

TZ=Asia/Shanghai
